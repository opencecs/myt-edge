[connection]
id=Y4 10G Bond DHCP
uuid=948fe2c1-4018-4acf-b25b-ecedb97c1000
type=bond
interface-name=bond10g
autoconnect=true
autoconnect-slaves=1
autoconnect-priority=200
autoconnect-retries=0
stable-id=y4-bond10g

[bond]
mode=802.3ad
miimon=100
updelay=200
downdelay=200
min_links=1
lacp_rate=fast
ad_select=bandwidth
xmit_hash_policy=layer3+4
all_slaves_active=0

[ipv4]
method=auto
may-fail=true
route-table=1010
route-metric=100
ignore-auto-dns=false

[ipv6]
method=auto
may-fail=true
route-table=1010
route-metric=100
ignore-auto-dns=false
